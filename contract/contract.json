{
  "contract": 3,
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Result",
    "description": "What a run of a model's function answers, from POST /v1/runs, /continue, /cancel and GET /v1/runs/{id}",
    "type": "object",
    "required": ["run_id", "model", "version", "function", "status", "data", "step", "prompt", "seconds"],
    "properties": {
      "run_id": { "type": "string" },
      "model": { "type": "string" },
      "version": { "type": "integer", "minimum": 1 },
      "function": { "type": "string" },
      "status": { "enum": ["done", "needs_input", "needs_approval", "failed", "expired", "cancelled"] },
      "data": {},
      "step": { "type": ["string", "null"] },
      "prompt": { "type": ["string", "null"] },
      "seconds": { "type": "number", "minimum": 0 }
    }
  },
  "answer": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Answer",
    "description": "What an Ada model's query answers: data of a done Result",
    "type": "object",
    "required": ["sufficient", "confidence", "support", "count", "top", "outcomes", "receipts"],
    "properties": {
      "sufficient": { "type": "boolean" },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "support": { "type": "number", "minimum": 0, "maximum": 1 },
      "count": { "type": "integer", "minimum": 0 },
      "top": { "type": ["string", "null"] },
      "outcomes": { "type": "object", "additionalProperties": { "type": "number" } },
      "receipts": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "sim", "outcome", "hash", "author"],
          "properties": {
            "id": { "type": "string" },
            "sim": { "type": "number" },
            "outcome": { "type": ["string", "null"] },
            "hash": { "type": "string" },
            "author": { "type": ["string", "null"] }
          }
        }
      }
    }
  },
  "error": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Error",
    "type": "object",
    "required": ["error"],
    "properties": {
      "error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
      }
    }
  }
}
