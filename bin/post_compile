#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${GLYPH_SDK_WHEEL_URL:-}" ]]; then
  echo "Installing Glyphh SDK from wheel..."
  WHEEL_NAME="${GLYPH_SDK_WHEEL_URL##*/}"
  if [[ -z "${WHEEL_NAME}" ]]; then
    WHEEL_NAME="glyphh-sdk.whl"
  fi
  WHEEL_PATH="/tmp/${WHEEL_NAME}"
  if [[ -n "${GLYPH_GITHUB_TOKEN:-}" ]]; then
    WHEEL_PATH="${WHEEL_PATH}" python - <<'PY'
import json
import os
import re
import urllib.request

url = os.environ.get("GLYPH_SDK_WHEEL_URL", "")
token = os.environ.get("GLYPH_GITHUB_TOKEN", "")
wheel_path = os.environ.get("WHEEL_PATH", "/tmp/glyphh-sdk.whl")
match = re.search(r"/releases/download/([^/]+)/([^/]+)$", url)
if not match:
    raise SystemExit("GLYPH_SDK_WHEEL_URL must be a GitHub releases/download URL.")
tag, filename = match.groups()
api_url = f"https://api.github.com/repos/glyphh-ai/glyphh-sdk/releases/tags/{tag}"
headers = {
    "Authorization": f"Bearer {token}",
    "Accept": "application/vnd.github+json",
    "User-Agent": "glyphh-runtime",
    "X-GitHub-Api-Version": "2022-11-28",
}
req = urllib.request.Request(api_url, headers=headers)
with urllib.request.urlopen(req) as resp:
    data = json.load(resp)
assets = data.get("assets") or []
asset = next((a for a in assets if a.get("name") == filename), None)
if not asset or not asset.get("url"):
    raise SystemExit(f"Wheel asset not found in release {tag}: {filename}")
asset_headers = {
    "Authorization": f"Bearer {token}",
    "Accept": "application/octet-stream",
    "User-Agent": "glyphh-runtime",
    "X-GitHub-Api-Version": "2022-11-28",
}
asset_req = urllib.request.Request(asset["url"], headers=asset_headers)
with urllib.request.urlopen(asset_req) as resp, open(wheel_path, "wb") as handle:
    handle.write(resp.read())
PY
    pip install --no-cache-dir "${WHEEL_PATH}"
  else
    pip install --no-cache-dir "${GLYPH_SDK_WHEEL_URL}"
  fi
else
  echo "GLYPH_SDK_WHEEL_URL not set; skipping SDK wheel install."
fi

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$APP_ROOT"

export PYTHONPATH="$APP_ROOT"

echo "Skipping migrations during build; release phase handles them."
