# Glyphh Runtime Configuration
# Copy to .env and customize

# Server
HOST=0.0.0.0
PORT=8000

# Deployment mode: local, self-hosted, cloud
DEPLOYMENT_MODE=local

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glyphh_runtime

# JWT Authentication (required for self-hosted/cloud)
# JWT_SECRET_KEY=your-secret-key-here
# JWT_ALGORITHM=HS256

# Licensing (required for self-hosted)
# LICENSE_KEY=your-license-key
# PLATFORM_API_URL=https://platform.glyphh.com/api

# NL Query (optional)
ENABLE_NL_QUERY=false
# NL_MODEL=microsoft/Phi-3.5-mini-instruct

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Resource quotas
DEFAULT_NAMESPACE_MEMORY_MB=1024
DEFAULT_NAMESPACE_STORAGE_GB=10

# Edge generation
EDGE_GENERATION_STRATEGY=lazy
EDGE_TTL_HOURS=24

# Beam search defaults
DEFAULT_BEAM_WIDTH=5
DEFAULT_MAX_TREE_DEPTH=3

# Logging
LOG_LEVEL=INFO

# Telemetry
TELEMETRY_ENABLED=true
# TELEMETRY_ENDPOINT=https://telemetry.glyphh.ai

# CORS (comma-separated)
CORS_ORIGINS=*
