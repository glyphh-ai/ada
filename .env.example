# Glyphh Runtime Configuration
# Copy to .env and customize

# ── Server ──
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO

# ── Database ──
# Leave unset for SQLite (default). Set for PostgreSQL + pgvector:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/glyphh_runtime

# Docker Compose overrides (only used by docker-compose.yml)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=glyphh_runtime
# DB_PORT=5432
# GLYPHH_PORT=8002

# ── Authentication ──
# JWT_SECRET_KEY=your-secret-key-here  # Set to match Platform's JWT_SECRET_KEY

# ── Dev flags ──
# ENABLE_DOCS=true       # Enable /docs and /redoc
# CORS_ALLOW_ALL=true    # Allow all CORS origins (dev only)

# ── Limits ──
RATE_LIMIT_PER_MINUTE=60
MAX_VECTOR_DIMENSION=2000

# ── CORS (production) ──
# CORS_ORIGINS=https://studio.glyphh.com,https://app.glyphh.com
