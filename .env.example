# Glyphh Runtime Configuration
# Copy to .env and customize

# ── Server ──
HOST=0.0.0.0
PORT=8002
DEPLOYMENT_MODE=local    # local | self-hosted | cloud
LOG_LEVEL=INFO

# ── Database (PostgreSQL + pgvector) ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/glyphh_runtime

# Docker Compose overrides (only used by docker-compose.yml)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=glyphh_runtime
# DB_PORT=5432
# GLYPHH_PORT=8002

# ── Authentication ──
# JWT_SECRET_KEY=your-secret-key-here
# JWT_ALGORITHM=HS256

# ── Licensing (self-hosted) ──
# LICENSE_KEY=your-license-key
# PLATFORM_API_URL=https://platform.glyphh.ai/api

# ── Limits ──
RATE_LIMIT_PER_MINUTE=60
MAX_VECTOR_DIMENSION=2000

# ── CORS ──
CORS_ORIGINS=*
