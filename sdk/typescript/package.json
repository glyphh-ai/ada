{
  "name": "@glyphh-ai/ada",
  "version": "0.1.0",
  "description": "Ada for TypeScript and JavaScript: typed models your software queries without a language model in the path.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run typecheck && node --test test/"
  },
  "keywords": [
    "glyphh",
    "ada",
    "typed",
    "deterministic",
    "graph",
    "decision"
  ],
  "homepage": "https://glyphh.ai/docs/ada",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glyphh-ai/ada.git",
    "directory": "sdk/typescript"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
